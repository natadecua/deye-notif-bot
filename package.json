{
  "name": "deye-battery-notify",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Deye battery notifications on Cloudflare Workers Free",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "tsx scripts/cli.ts setup",
    "setup:demo": "tsx scripts/setup-demo.ts",
    "preview": "tsx scripts/cli.ts preview",
    "telegram:test": "tsx scripts/cli.ts telegram-test",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:mock": "tsx scripts/mock-demo.ts",
    "dev": "tsx scripts/cli.ts init && wrangler dev --test-scheduled",
    "build": "tsx scripts/cli.ts init && wrangler deploy --dry-run --outdir dist",
    "deploy": "tsx scripts/cli.ts validate-deploy && wrangler deploy",
    "deploy:ci": "tsx scripts/ci-deploy-cli.ts",
    "secrets:upload": "tsx scripts/cli.ts secrets-upload",
    "test:runtime": "tsx --test test/runtime/*.test.ts",
    "telegram:chats": "tsx scripts/cli.ts telegram-chats",
    "telegram:setup": "tsx scripts/cli.ts telegram-setup",
    "telegram:webhook": "tsx scripts/cli.ts telegram-webhook",
    "preferences": "tsx scripts/cli.ts preferences",
    "daytime:setup": "tsx scripts/cli.ts daytime-setup",
    "weather:setup": "tsx scripts/cli.ts weather-setup",
    "health:setup": "tsx scripts/cli.ts health-setup",
    "recap:setup": "tsx scripts/cli.ts recap-setup"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@inquirer/prompts": "^8.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261019.1-beta",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
