{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deye-battery-notify",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "kv_namespaces": [{ "binding": "STATE", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }],
  "observability": { "enabled": false },
  "vars": {
    "MONITOR_CONFIG": {
      "enabled": false,
      "region": "eu",
      "stationId": 0,
      "powerUnit": "W",
      "measurementsConfirmed": false,
      "timestampMode": "iso-offset",
      "fullSoc": 100,
      "fullRearmSoc": 97,
      "dischargeWatts": 300,
      "dischargeRearmWatts": 100,
      "maxAgeSeconds": 600,
      "maxGapSeconds": 720,
      "notifications": { "full": true, "discharge": true },
      "telegram": { "enabled": false },
      "ev": { "enabled": false }
    }
  }
}
